3. Selection Sort:

package sortingalgo;
import java.util.Scanner;
public class SelectionSort {
	static void Sort(int[] a,int n) {
	int i,j,min_index,temp;
	for(i=0; i<=n-2;i++)
	{
		min_index= i;
		for(j=i+1;j<=n-1;j++)
		{
			if(a[min_index]>a[j])
				min_index = j;
		}
		if (min_index!=i)
		{
			temp = a[i];
			a[i] = a[min_index];
