4.  Shell sort:

package pfiles;
import java.util.Scanner;
public class ShellSort {
	static void sort(int a[], int n, int inc[], int numinc)
	{
		int incr, span, y, i, j, k, l;
		for(incr=0; incr<numinc; incr++)
		{
			span = inc[incr];
			System.out.println("Span value is: "+span);
			for(j=span;j<n;j++)
			{
				
				y = a[j];
				for(k = j-span; k>=0 && y<a[k]; k -= span) { a[k+span] =a[k]; }
				
				a[k+span] = y;	
			}
			
			System.out.println("Array elements after span: "+span);
			for(i=0; i<n; i++) { System.out.println(a[i]+" ");}
			System.out.println("\n");
			
			System.out.println("Sorted Array: ");
			for(i=0; i<n; i++) { System.out.println(a[i]+" ");}
		}
	}
