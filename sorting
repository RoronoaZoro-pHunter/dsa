5. Quick sort:

package pfiles;
import java.util.Scanner;
public class QuickSort {
	static int partition(int a[], int beg, int end) {
		int piv=a[beg];
		int up = end;
		int down = beg;
		int temp;
		
		while(down < up)
			down = down + 1;
		 while(a[up] > piv)
			 up = up - 1;
		 if (down < up) {
			 temp = a[down];
			 a[down] = a[up];
			 a[up] = temp;
		 }
		 temp = a[beg];
		 a[beg] = a[up];
		 a[up] = temp;
		
		 return up;
		
	}
	
	static void sort(int a[], int beg, int end) {
		int j;
		if(beg < end) {
			j = partition(a, beg, end);
			sort(a, beg, j-1);
			sort(a, j+1, end);
		}
		else
			return;
	}
	
	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		int a []=new int [30];
		int n ,i,beg,end;
				
		System.out.println("Enter array size: ");
		n=sc.nextInt();
		beg = 0;
		end = n - 1;
		
		System.out.println("Enter array element: ");
		for (i=0; i < n; i++) {
			a[i]=sc.nextInt();
		}
		
		sort(a,beg,end);
		System.out.println("Sorted Array: ");
		for (i=0; i < n; i++) {
			System.out.print(a[i]+" ");
		}
	}
}




6. Merg sort:

package sortings;
 
import java.util.Scanner;
 
public class MergSort {
	static void merge(int a[],int low,int mid,int high)
	{
     	int h,i,j,k;
     	h=low;
     	i=low;
     	j=mid+1;
     	int []b=new int[30];
     	while((h<=mid)&&(j<=high))
     	{
         	if(a[h]<=a[j])
         	{
             	b[i]=a[h];
             	h=h+1;
         	}
         	else
         	{
             	b[i]=a[j];
             	j=j+1;
         	}
         	i=i+1;
     	}
     	if(h>mid)
     	{
         	for(k=j;k<=high;k++) {
             	b[i]=a[k];
             	i++;
         	}
     	}
     	else
     	{
         	for(k=h;k<=mid;k++)
         	{
             	b[i]=a[k];
             	i++;
     	}
     	}
     	for(k=low;k<=high;k++)
     	{
         	a[k]=b[k];
     	}
	}
	static void sort(int a[], int low,int high) {
     	int mid;
     	if(low<high)
     	{
         	mid=(low+high)/2;
         	sort(a,low,mid);
         	sort(a,mid+1,high);
         	merge(a,low,mid,high);
     	}  
     	}
	public static void main(String[] args) {
     	// TODO Auto-generated method stub
     	
     	Scanner sc= new Scanner(System.in);
     	int n,i,low,high;
     	int a[]=new int[30];
     	System.out.println("Enter array Size: ");
     	n=sc.nextInt();
     	low=0;
     	high=n-1;
     	System.out.println("Enter elements of array: ");
     	for(i=0;i<n;i++)
     	{
         	a[i]=sc.nextInt();
     	}
     	sort(a,low,high);
     	System.out.println("Sorted Array: ");
     	for(i=0;i<n;i++)
     	{
         	System.out.println(a[i] + " ");
     	}
	}
}
